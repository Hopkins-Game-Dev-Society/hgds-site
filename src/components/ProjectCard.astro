---
interface Props {
  title: string
  shortDescription: string
  slug: string
  image?: string
  imageAlt?: string
  imageOffsetY?: number
}

const {
  title,
  shortDescription,
  slug,
  image,
  imageAlt,
  imageOffsetY = 50
} = Astro.props;
---

<article class="card">
  {image && (
    <div class="card-media">
        <img
        src={image}
        alt={imageAlt ?? `${title} screenshot`}
        style={`object-position: center ${imageOffsetY}%`}
        />
    </div>
    )}

  <div class="card-body">
    <h3 class="card-title">{title}</h3>

    <p class="card-text">{shortDescription}</p>

    <a class="card-link" href={`/projects/${slug}`}>
      Learn more <span aria-hidden="true">→</span>
    </a>
  </div>
</article>
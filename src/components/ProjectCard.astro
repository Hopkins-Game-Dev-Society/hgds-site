---
import { Image } from "astro:assets";
import { getProjectImage } from "../utils/images";

interface Props {
  title: string
  shortDescription: string
  slug: string
  status?: "active" | "archived"
  // Opt-in: render the "In Development" badge for non-archived projects.
  // Kept as a supported feature; currently disabled from the projects page.
  showStatus?: boolean
  image?: string
  imageAlt?: string
  imageOffsetY?: number
}

const {
  title,
  shortDescription,
  slug,
  status,
  showStatus = false,
  image,
  imageAlt,
  imageOffsetY = 50
} = Astro.props;

const asset = getProjectImage(image);
---

<a class="card" href={`/projects/${slug}`}>
  {image && (
    <div class="card-media">
      {asset ? (
        <Image
          src={asset}
          alt={imageAlt ?? `${title} screenshot`}
          widths={[400, 800]}
          sizes="(max-width: 640px) 100vw, 400px"
          format="webp"
          loading="lazy"
          style={`object-position: center ${imageOffsetY}%`}
        />
      ) : (
        <img
          src={image}
          alt={imageAlt ?? `${title} screenshot`}
          loading="lazy"
          style={`object-position: center ${imageOffsetY}%`}
        />
      )}
    </div>
  )}

  <div class="card-body">
    <div class="card-heading">
      <h3 class="card-title">{title}</h3>
      {showStatus && status !== "archived" && (
        <span class="status-badge">In Development</span>
      )}
    </div>

    {shortDescription && <p class="card-text">{shortDescription}</p>}

    <p class="card-link">
      Learn more <span aria-hidden="true">→</span>
    </p>
  </div>
</a>

<style>
  .card-heading {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.75rem;
    flex-wrap: wrap;
  }

  .status-badge {
    font-size: 0.7rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    padding: 0.2rem 0.6rem;
    border-radius: 999px;
    background: var(--brand-gold);
    color: var(--brand-blue);
    border: 1px solid #cfab70;
    white-space: nowrap;
  }
</style>
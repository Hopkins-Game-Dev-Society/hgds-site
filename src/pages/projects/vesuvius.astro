---
import Layout from "@layouts/Layout.astro";
import { projects } from "../../data/projects";

const project = projects.find((p) => p.slug === "vesuvius");
---

<Layout title="Vesuvius | Hopkins Game Dev Society">
  <section class="project-page">
    {project?.image && (
      <div class="project-hero">
        <img
          src={project.image}
          alt={project.imageAlt ?? `${project.title} cover`}
          style={`object-position: center ${project.imageOffsetY ?? 50}%`}
        />
      </div>
    )}

    <p class="back-link-wrap">
      <a href="/projects" class="back-link">← Back to Projects</a>
    </p>

    <h1>{project?.title}</h1>

    <p class="project-lede">
      A surreal metroidvania where you uncover the secrets of a snowy Mt. Vesuvius,
      its mysterious cult, and the strange forces twisting its depths.
    </p>

    <div class="project-actions">
      <a
        href="https://l1ryx.itch.io/vesuvius"
        target="_blank"
        rel="noopener noreferrer"
        class="button-link btn-interactive"
      >
        Play Demo
      </a>

      <a
        href="https://vesuviusgame.com"
        target="_blank"
        rel="noopener noreferrer"
        class="button-link btn-interactive"
      >
        Visit Website
      </a>
    </div>

    <section class="project-section">
      <h2>About the Game</h2>

      <div class="project-copy">
        <p>
          Set on a reimagined Mt. Vesuvius, you are to uncover the mystery of a vanished
          cult that disappeared into the mountain years ago. Within its depths, you will
          traverse a series of biomes that defy logic — lush forests, icy caves, tranquil
          lakes, and more — all hidden beneath the snow. Reality often bends, leaving
          questions on what is real as you navigate shifting landscapes and uncover the
          mountain’s secrets.
        </p>

        <p>
          You will navigate the world through precise platforming, engage in combat with
          mysterious foes, embark on quests with enigmatic NPCs, and uncover the story
          woven into the mountain’s surreal environments. Along the way, you’ll discover
          new abilities that allow you to explore further, unlocking secrets hidden in
          every corner of this sprawling, interconnected world.
        </p>
      </div>
    </section>

    <section class="project-section">
      <h2>Team</h2>

      <ul class="team-list">
        <li><strong>Shawn Guo</strong> — Creative Lead, Programming, Audio, Art</li>
        <li><strong>Brett Wolfinger</strong> — Technical Lead, Programming, Art</li>
      </ul>
    </section>
  </section>
</Layout>

<style>
  .project-page {
    padding: 2rem 0;
  }

  .back-link-wrap {
    margin-bottom: 0.75rem;
  }

  .back-link {
    font-weight: 600;
  }

  .project-lede {
    margin: 0 0 1.75rem;
    max-width: 800px;
    font-size: 1.1rem;
    line-height: 1.75;
    color: var(--muted);
  }

  .project-actions {
    margin: 0 0 2.5rem;
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .project-section {
    margin-top: 2.5rem;
    max-width: 850px;
  }

  .project-copy p {
    margin: 0 0 1.25rem;
    line-height: 1.8;
    color: var(--text);
  }

  .team-list {
    margin: 0;
    padding-left: 1.25rem;
    line-height: 1.9;
    color: var(--text);
  }

  .team-list li + li {
    margin-top: 0.25rem;
  }
</style>
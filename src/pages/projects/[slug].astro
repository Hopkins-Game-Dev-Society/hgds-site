---
import { Image, getImage } from "astro:assets";
import Layout from "@layouts/Layout.astro";
import { projects } from "../../data/projects";
import { getProjectImage } from "../../utils/images";
import { videoGame } from "../../utils/structuredData";
import type { Project } from "../../data/projects";

export function getStaticPaths() {
  return projects.map((project) => ({
    params: { slug: project.slug },
    props: { project },
  }));
}

interface Props {
  project: Project;
}

const { project } = Astro.props;

const heroAsset = getProjectImage(project.image);

// Thumbnails are sized by height (the gallery rows are height-constrained), and the
// lightbox gets a capped full-size WebP so huge originals are never shipped.
const shots = await Promise.all(
  (project.screenshots ?? []).map(async (shot) => {
    const asset = getProjectImage(shot.src);
    const full = asset
      ? await getImage({
          src: asset,
          width: Math.min(asset.width, 1920),
          format: "webp",
        })
      : null;
    return { ...shot, asset, fullSrc: full?.src ?? shot.src };
  }),
);

// Projects still awaiting real write-ups show an under-construction note
const needsContent = !project.about || project.about.length === 0;

// Search snippet / link preview: the first non-empty of tagline, card blurb, or the
// opening about paragraph, trimmed at a word boundary to fit the ~160-char snippet.
const summarySource =
  [project.tagline, project.shortDescription, project.about?.[0]]
    .map((text) => text?.trim())
    .find((text) => text) ??
  `${project.title}, a game made by students in the Hopkins Game Dev Society at Johns Hopkins University.`;
const description =
  summarySource.length <= 160
    ? summarySource
    : `${summarySource.slice(0, 157).replace(/\s+\S*$/, "")}...`;

// Share image: a JPEG of the cover (widest format support among link unfurlers).
// Animated GIF covers aren't optimized assets, so they're shared as-is.
const shareImage = heroAsset
  ? (
      await getImage({
        src: heroAsset,
        width: Math.min(heroAsset.width, 1200),
        format: "jpg",
      })
    ).src
  : project.image;

// Search-engine data for the game, pulled straight from its projects.ts entry.
const gameJsonLd = videoGame(
  project,
  [shareImage, ...shots.map((shot) => shot.fullSrc)].filter(
    (src): src is string => Boolean(src),
  ),
);
---

<Layout
  title={`${project.title} | Hopkins Game Dev Society`}
  description={description}
  image={shareImage}
  imageAlt={project.imageAlt ?? `${project.title} cover`}
  jsonLd={gameJsonLd}
>
  <section class="project-page">
    {project.image && (
      <div class="project-hero">
        {heroAsset ? (
          <Image
            src={heroAsset}
            alt={project.imageAlt ?? `${project.title} cover`}
            widths={[900, 1800]}
            sizes="(max-width: 900px) 100vw, 900px"
            format="webp"
            loading="eager"
            style={`object-position: center ${project.imageOffsetY ?? 50}%`}
          />
        ) : (
          <img
            src={project.image}
            alt={project.imageAlt ?? `${project.title} cover`}
            style={`object-position: center ${project.imageOffsetY ?? 50}%`}
          />
        )}
      </div>
    )}

    <p class="back-link-wrap">
      <a href="/projects" class="back-link">← Back to Projects</a>
    </p>

    <h1>{project.title}</h1>

    {project.tagline && <p class="project-lede">{project.tagline}</p>}

    {project.links && project.links.length > 0 && (
      <div class="project-actions">
        {project.links.map((link) => (
          <a
            href={link.url}
            target="_blank"
            rel="noopener noreferrer"
            class="button-link btn-interactive"
          >
            {link.label}
          </a>
        ))}
      </div>
    )}

    {needsContent && (
      <p class="under-construction">
        <strong>This page is under construction.</strong> We're still gathering a
        write-up, screenshots, and full credits for this project. If you worked on
        it and can help fill in the blanks, let us know in our
        <a href="https://discord.gg/XnWkcpeRhp" target="_blank" rel="noopener noreferrer">Discord</a>.
      </p>
    )}

    {project.about && project.about.length > 0 && (
      <section class="project-section">
        <h2>About the Game</h2>

        <div class="project-copy">
          {project.about.map((paragraph) => (
            <p>{paragraph}</p>
          ))}
        </div>
      </section>
    )}

    {project.team && project.team.length > 0 && (
      <section class="project-section">
        <h2>Team</h2>

        <ul class="team-list">
          {project.team.map((member) => (
            <li>
              <strong>{member.name}</strong>
              {member.roles.length > 0 && <> — {member.roles.join(", ")}</>}
            </li>
          ))}
        </ul>
      </section>
    )}

    {project.screenshots && project.screenshots.length > 0 && (
      <section class="project-section">
        <h2>Gallery</h2>

        <div class="screenshots-grid">
          {shots.map((shot) => (
            <button
              type="button"
              class="screenshot-card"
              data-lightbox-src={shot.fullSrc}
              data-lightbox-alt={shot.alt}
            >
              {shot.asset ? (
                <Image
                  src={shot.asset}
                  alt={shot.alt}
                  height={560}
                  format="webp"
                  loading="lazy"
                />
              ) : (
                <img src={shot.src} alt={shot.alt} loading="lazy" />
              )}
            </button>
          ))}
        </div>
      </section>
    )}
  </section>
  <div id="lightbox" class="lightbox">
    <img id="lightbox-img" src="" alt="" />
  </div>
</Layout>

<style>
  .project-page {
    padding: 2rem 0;
  }

  .back-link-wrap {
    margin-bottom: 0.75rem;
  }

  .back-link {
    font-weight: 600;
  }

  .project-lede {
    margin: 0 0 1.75rem;
    max-width: 800px;
    font-size: 1.1rem;
    line-height: 1.75;
    color: var(--muted);
  }

  .project-actions {
    margin: 0 0 2.5rem;
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .under-construction {
    max-width: 800px;
    margin: 0 0 2rem;
    padding: 1rem 1.25rem;
    background: var(--panel);
    border: 1px solid var(--border);
    border-left: 3px solid var(--brand-gold);
    border-radius: var(--radius);
    color: var(--muted);
    line-height: 1.7;
  }

  .under-construction strong {
    color: var(--text);
  }

  .project-section {
    margin-top: 2.5rem;
    max-width: 850px;
  }

  .project-copy p {
    margin: 0 0 1.25rem;
    line-height: 1.8;
    color: var(--text);
  }

  .team-list {
    margin: 0;
    padding-left: 1.25rem;
    line-height: 1.9;
    color: var(--text);
  }

  .team-list li + li {
    margin-top: 0.25rem;
  }

  /* Fixed-height rows where each tile takes its image's natural width, so
     mixed portrait / square / widescreen shots coexist without cropping */
  .screenshots-grid {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    margin-top: 1rem;
  }

  .screenshot-card {
    padding: 0;
    height: 280px;
    max-width: 100%;
    overflow: hidden;
    border-radius: var(--radius);
    border: 1px solid var(--border);
    background: var(--panel);
    box-shadow: var(--shadow);
    cursor: zoom-in;
    transition:
      transform 0.18s ease,
      border-color 0.18s ease,
      box-shadow 0.18s ease;
  }

  .screenshot-card:hover {
    transform: translateY(-3px);
    border-color: var(--brand-blue-light);
    box-shadow: 0 14px 34px rgba(0, 0, 0, 0.12);
  }

  .screenshot-card img {
    display: block;
    height: 100%;
    width: auto;
    max-width: 100%;
    object-fit: contain;
  }

  @media (max-width: 640px) {
    .screenshot-card {
      height: 200px;
    }
  }

  .lightbox {
    position: fixed;
    inset: 0;
    background: rgba(0,0,0,0.85);
    display: none;
    align-items: center;
    justify-content: center;
    z-index: 1000;
  }

  .lightbox img {
    max-width: 90vw;
    max-height: 90vh;
    border-radius: var(--radius);
  }

</style>

<script>
  function openLightbox(src: string, alt: string): void {
    const lightbox = document.getElementById("lightbox");
    const img = document.getElementById("lightbox-img");

    if (!(lightbox instanceof HTMLDivElement)) return;
    if (!(img instanceof HTMLImageElement)) return;

    img.src = src;
    img.alt = alt;
    lightbox.style.display = "flex";
  }

  function closeLightbox(): void {
    const lightbox = document.getElementById("lightbox");

    if (!(lightbox instanceof HTMLDivElement)) return;

    lightbox.style.display = "none";
  }

  const screenshotCards = document.querySelectorAll(".screenshot-card");
  const lightbox = document.getElementById("lightbox");
  const lightboxImg = document.getElementById("lightbox-img");

  screenshotCards.forEach((card) => {
    if (!(card instanceof HTMLButtonElement)) return;

    card.addEventListener("click", () => {
      const src = card.dataset.lightboxSrc;
      const alt = card.dataset.lightboxAlt ?? "";

      if (!src) return;

      openLightbox(src, alt);
    });
  });

  if (lightbox instanceof HTMLDivElement) {
    lightbox.addEventListener("click", () => {
      closeLightbox();
    });
  }

  document.addEventListener("keydown", (event: KeyboardEvent) => {
    if (event.key === "Escape") {
      closeLightbox();
    }
  });

  if (lightboxImg instanceof HTMLImageElement) {
    lightboxImg.addEventListener("click", (event: MouseEvent) => {
      event.stopPropagation();
    });
  }
</script>

---
import Layout from "@layouts/Layout.astro";
import JamCard from "@components/JamCard.astro";
import { jams } from "../data/jams";

const hostedJams = jams.filter((jam) => jam.role === "hosted");
const joinedJams = jams.filter((jam) => jam.role === "participated");
---

<Layout title="Game Jams | Hopkins Game Dev Society">
  <section>
    <h1>Game Jams</h1>

    <p class="lede">
      We host our own on campus and host coworking sessions throughout the year. 
      Many of the games in our projects list started as jam entries.
    </p>
  </section>

  {jams.length === 0 && (
    <section class="section">
      <p class="lede">
        We're putting together our jam history. In the meantime,
        <a href="https://discord.gg/XnWkcpeRhp" target="_blank" rel="noopener noreferrer">
          join the Discord</a> to hear about the next one.
      </p>
    </section>
  )}

  {hostedJams.length > 0 && (
    <section class="section">
      <h2>Hosted by HGDS</h2>

      <div class="grid" style="margin-top: 1.5rem;">
        {hostedJams.map((jam) => <JamCard jam={jam} />)}
      </div>
    </section>
  )}

  {joinedJams.length > 0 && (
    <section class="section">
      <h2>Jams We've Joined</h2>

      <div class="grid" style="margin-top: 1.5rem;">
        {joinedJams.map((jam) => <JamCard jam={jam} />)}
      </div>
    </section>
  )}
</Layout>

---
import Layout from "@layouts/Layout.astro";
import JamCard from "@components/JamCard.astro";
import { jams } from "../data/jams";
---

<Layout
  title="Game Jams | Hopkins Game Dev Society"
  description="Game jams hosted and joined by the Hopkins Game Dev Society, plus the games Johns Hopkins students built at each one."
>
  <section>
    <h1>Game Jams</h1>

    <p class="lede">
      We host our own on campus and host coworking sessions throughout the year. 
      Many of the games in our projects list started as jam entries.
    </p>
  </section>

  {jams.length === 0 && (
    <section class="section">
      <p class="lede">
        We're putting together our jam history. In the meantime,
        <a href="https://discord.gg/XnWkcpeRhp" target="_blank" rel="noopener noreferrer">
          join the Discord</a> to hear about the next one.
      </p>
    </section>
  )}

  {jams.length > 0 && (
    <section class="section">
      <div class="grid">
        {jams.map((jam) => <JamCard jam={jam} />)}
      </div>
    </section>
  )}

</Layout>

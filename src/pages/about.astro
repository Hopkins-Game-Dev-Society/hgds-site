---
import Layout from "@layouts/Layout.astro";
---

<Layout title="About | Hopkins Game Dev Society">
  <section style="padding: 2rem 0;">
    <h1>About Us</h1>

    <p style="max-width: 750px; line-height: 1.6; color: #b8c0e0;">
      The Hopkins Game Dev Society is a student organization at Johns Hopkins University
      focused on bringing together students interested in game development, design, art,
      programming, audio, and interactive storytelling.
    </p>

    <p style="max-width: 750px; line-height: 1.6; color: #b8c0e0;">
      We support collaborative student projects, help members build practical skills,
      and create a space for people to learn, experiment, and make games together.
    </p>

    <p>
      <a href="/projects">View our projects</a>
    </p>
  </section>
</Layout>
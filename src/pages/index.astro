---
import Layout from "@layouts/Layout.astro";
import ProjectCard from "@components/ProjectCard.astro";
import { projects } from "../data/projects";
---

<Layout title="Hopkins Game Dev Society">
  <section style="padding: 2rem 0 3rem;">
    <h1 style="font-size: 2.5rem; margin-bottom: 0.5rem;">Hopkins Game Dev Society</h1>
    <p style="font-size: 1.1rem; color: #b8c0e0; margin-bottom: 1.5rem;">
      A Community of Game Developers @ Johns Hopkins University
    </p>
    <a href="/about">About us</a>
  </section>

  <section>
    <h2 style="margin-bottom: 1.5rem;">Active Projects</h2>

    <div
      style="display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 1rem;"
    >
      <div
        style="display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 1rem;"
      >
        {projects.map((project) => (
          <ProjectCard
            title={project.title}
            shortDescription={project.shortDescription}
            slug={project.slug}
          />
        ))}
      </div>
    </div>
  </section>
</Layout>
---
const { title = "Hopkins Game Dev Society" } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <style>
      :root {
        --bg: #0b1020;
        --panel: #121933;
        --text: #f5f7ff;
        --muted: #b8c0e0;
        --accent: #7fb3ff;
        --border: #2a3566;
        --max-width: 1100px;
      }

      * {
        box-sizing: border-box;
      }

      html, body {
        margin: 0;
        padding: 0;
        font-family: Arial, Helvetica, sans-serif;
        background: var(--bg);
        color: var(--text);
      }

      a {
        color: var(--accent);
        text-decoration: none;
      }

      a:hover {
        text-decoration: underline;
      }

      header {
        border-bottom: 1px solid var(--border);
        background: rgba(11, 16, 32, 0.95);
      }

      .container {
        width: min(var(--max-width), calc(100% - 2rem));
        margin: 0 auto;
      }

      .nav {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 1rem 0;
      }

      .nav-links {
        display: flex;
        gap: 1rem;
      }

      main {
        padding: 3rem 0;
      }

      footer {
        border-top: 1px solid var(--border);
        margin-top: 4rem;
        padding: 2rem 0;
        color: var(--muted);
      }
    </style>
  </head>
  <body>
    <header>
      <div class="container nav">
        <a href="/"><strong>HGDS</strong></a>
        <nav class="nav-links">
          <a href="/about">About</a>
          <a href="/projects">Projects</a>
        </nav>
      </div>
    </header>

    <main class="container">
      <slot />
    </main>

	<footer>
		<div class="container">
		  <p>Hopkins Game Dev Society</p>
		  <p>
			<a href="https://discord.com/invite/AvyRN8Y8wk" target="_blank" rel="noopener noreferrer">
			  Join our Discord
			</a>
			·
			<a href="mailto:hopkinsgamedevclub@gmail.com">
			  hopkinsgamedevclub@gmail.com
			</a>
		  </p>
		</div>
	  </footer>
  </body>
</html>
---
const { title = "Hopkins Game Dev Society" } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <style is:global>

    .btn-interactive {
        transition: all 0.2s ease-in-out;
        display: inline-block;
        text-decoration: none;
        /* Ensure colors match your variables */
        background-color: #121933;
        color: #b8c0e0;
        border: 1px solid #2a3566;
      }

      .btn-interactive:hover {
        background-color: #b8c0e0 !important;
        color: #121933 !important;
        border-color: #b8c0e0 !important;
        cursor: pointer;
      }

      :root {
        --bg: #0a1020;
        --bg-elevated: #121a30;
        --panel: #16213d;
        --panel-hover: #1b2a4d;
        --text: #f4f7ff;
        --muted: #b6c2e1;
        --accent: #c0cbdd;
        --accent-strong: #a7c7ff;
        --border: #2a3966;
        --max-width: 1100px;
        --radius: 16px;
        --shadow: 0 10px 30px rgba(0, 0, 0, 0.22);
      }

      * {
        box-sizing: border-box;
      }

      html {
        scroll-behavior: smooth;
      }

      body {
        margin: 0;
        min-height: 100vh;
        font-family: Inter, Arial, Helvetica, sans-serif;
        background:
          radial-gradient(circle at top, rgba(76, 110, 245, 0.12), transparent 35%),
          linear-gradient(180deg, #0a1020 0%, #0b1224 100%);
        color: var(--text);
      }

      a {
        color: var(--accent);
        text-decoration: none;
        transition: color 0.18s ease, opacity 0.18s ease;
      }

      a:hover {
        color: var(--accent-strong);
      }

      h1,
      h2,
      h3 {
        line-height: 1.15;
        margin-top: 0;
        letter-spacing: -0.02em;
      }

      h1 {
        font-size: clamp(2.25rem, 5vw, 3.75rem);
        margin-bottom: 0.75rem;
      }

      h2 {
        font-size: clamp(1.5rem, 3vw, 2rem);
        margin-bottom: 1rem;
      }

      h3 {
        font-size: 1.15rem;
        margin-bottom: 0.75rem;
      }

      p {
        line-height: 1.7;
      }

      .container {
        width: min(var(--max-width), calc(100% - 2rem));
        margin: 0 auto;
      }

      .site-header {
        position: sticky;
        top: 0;
        z-index: 10;
        backdrop-filter: blur(10px);
        background: rgba(10, 16, 32, 0.82);
        border-bottom: 1px solid rgba(42, 57, 102, 0.8);
      }

      .nav {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 1rem;
        min-height: 72px;
      }

      .brand {
        display: inline-flex;
        align-items: center;
        font-weight: 700;
        font-size: 1rem;
        color: var(--text);
        letter-spacing: 0.01em;
      }

      .brand:hover {
        color: var(--text);
        opacity: 0.9;
      }

      .nav-links {
        display: flex;
        align-items: center;
        gap: 1.25rem;
      }

      .nav-links a {
        color: var(--muted);
        font-weight: 500;
      }

      .nav-links a:hover {
        color: var(--text);
      }

      main {
        padding: 3.5rem 0 4rem;
      }

      .section {
        margin-top: 3rem;
      }

      .lede {
        font-size: 1.1rem;
        max-width: 760px;
        color: var(--muted);
      }

      .button-link {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        padding: 0.8rem 1rem;
        border: 1px solid var(--border);
        border-radius: 999px;
        background: rgba(22, 33, 61, 0.9);
        color: var(--text);
        font-weight: 600;
        transition:
          transform 0.18s ease,
          background 0.18s ease,
          border-color 0.18s ease;
      }

      .button-link:hover {
        transform: translateY(-1px);
        background: var(--panel-hover);
        border-color: #4560a8;
        color: var(--text);
      }

      .grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
        gap: 1rem;
      }

      .site-footer {
        margin-top: 4rem;
        border-top: 1px solid rgba(42, 57, 102, 0.8);
        background: rgba(10, 16, 32, 0.5);
      }

      .footer-inner {
        padding: 2rem 0 3rem;
      }

      .footer-title {
        margin: 0 0 0.5rem;
        font-weight: 700;
      }

      .footer-links {
        display: flex;
        flex-wrap: wrap;
        gap: 0.75rem;
        color: var(--muted);
      }

      .footer-links a {
        color: var(--muted);
      }

      .footer-links a:hover {
        color: var(--text);
      }

      .card {
        height: 100%;
        border: 1px solid var(--border);
        background: linear-gradient(180deg, rgba(22, 33, 61, 0.98), rgba(18, 26, 48, 0.98));
        border-radius: var(--radius);
        box-shadow: var(--shadow);
        overflow: hidden;
        transition:
          transform 0.18s ease,
          border-color 0.18s ease,
          background 0.18s ease,
          box-shadow 0.18s ease;
      }

      .card:hover {
        transform: translateY(-3px);
        border-color: #4560a8;
        background: linear-gradient(180deg, rgba(27, 42, 77, 0.98), rgba(20, 30, 54, 0.98));
        box-shadow: 0 14px 34px rgba(0, 0, 0, 0.28);
      }

      .card-body {
        padding: 1.25rem;
      }

      .card-title {
        margin: 0 0 0.75rem;
      }

      .card-text {
        margin: 0 0 1.25rem;
        color: var(--muted);
      }

      .card-link {
        display: inline-flex;
        align-items: center;
        gap: 0.4rem;
        font-weight: 600;
      }

      .card-media {
        width: 100%;
        aspect-ratio: 16 / 9;
        overflow: hidden;
        background: rgba(255, 255, 255, 0.03);
        border-bottom: 1px solid rgba(42, 57, 102, 0.7);
      }

      .card-media img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        display: block;
      }

      .project-hero {
        width: 100%;
        max-width: 900px;
        margin: 2rem auto 2.5rem;
        border-radius: var(--radius);
        overflow: hidden;
        border: 1px solid var(--border);
        box-shadow: var(--shadow);
      }

      .project-hero img {
        width: 100%;
        height: auto;
        display: block;
        object-fit: cover;
      }

      @media (max-width: 640px) {
        .nav {
          min-height: auto;
          padding: 1rem 0;
          flex-direction: column;
          align-items: flex-start;
        }

        main {
          padding-top: 2.5rem;
        }
      }
    </style>
  </head>
  <body>
    <header class="site-header">
      <div class="container nav">
        <a class="brand" href="/">Hopkins Game Dev Society</a>

        <nav class="nav-links">
          <a href="/about">About</a>
          <a href="/projects">Projects</a>
        </nav>
      </div>
    </header>

    <main class="container">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="container footer-inner">
        <p class="footer-title">Hopkins Game Dev Society</p>

        <div class="footer-links">
          <a href="https://discord.com/invite/AvyRN8Y8wk" target="_blank" rel="noopener noreferrer">
            Discord
          </a>
          <span>·</span>
          <a href="mailto:hopkinsgamedevclub@gmail.com">hopkinsgamedevclub@gmail.com</a>
        </div>
      </div>
    </footer>
  </body>
</html>
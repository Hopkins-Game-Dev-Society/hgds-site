---
const { title = "Hopkins Game Dev Society" } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <link rel="icon" href="/images/hgds-logo.png" />
    <link rel="shortcut icon" href="/images/hgds-logo.png" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Ubuntu+Mono:wght@400;700&display=swap" rel="stylesheet">
    <style is:global>

      .btn-interactive {
        transition: all 0.2s ease-in-out;
        display: inline-block;
        text-decoration: none;
        background-color: var(--brand-gold);
        color: var(--brand-blue);
        border: 1px solid #cfab70;
      }

      .btn-interactive:hover {
        background-color: var(--brand-blue) !important;
        color: #ffffff !important;
        border-color: var(--brand-blue) !important;
        cursor: pointer;
      }

      :root {
        --bg: #f4f7fb;
        --bg-elevated: #ffffff;

        --panel: #ffffff;
        --panel-hover: #f7f9fc;

        --text: #142033;
        --muted: #5f6b7a;

        --brand-gold: #e1bf89;
        --brand-blue: #002d72;
        --brand-blue-light: #68ace5;

        --accent: var(--brand-blue);
        --accent-strong: var(--brand-blue-light);

        --border: #d9e2ec;

        --header-bg: #081a3a;
        --footer-bg: #081a3a;
        --header-text: #f5f8ff;
        --header-muted: #c7d6ee;
        --header-border: rgba(104, 172, 229, 0.2);

        --max-width: 1100px;
        --radius: 16px;
        --shadow: 0 10px 30px rgba(0, 0, 0, 0.08);
      }

      * {
        box-sizing: border-box;
      }

      html {
        scroll-behavior: smooth;
      }

      body {
        margin: 0;
        min-height: 100vh;
        font-family: "Inter", system-ui, sans-serif;
        background: var(--bg);
        color: var(--text);
        -webkit-font-smoothing: antialiased;
      }

      a {
        color: var(--brand-blue);
        text-decoration: none;
        transition: color 0.18s ease, opacity 0.18s ease;
      }

      a:hover {
        color: var(--brand-blue-light);
      }

      h1,
      h2,
      h3 {
        line-height: 1.15;
        margin-top: 0;
        letter-spacing: -0.02em;
        font-family: "Ubuntu Mono", monospace;
        color: var(--brand-blue);
        letter-spacing: 0.03em;
      }

      h1 {
        font-size: clamp(2.25rem, 5vw, 3.75rem);
        margin-bottom: 0.75rem;
      }

      h2 {
        font-size: clamp(1.5rem, 3vw, 2rem);
        margin-bottom: 1rem;
      }

      h3 {
        font-size: 1.15rem;
        margin-bottom: 0.75rem;
      }

      p {
        line-height: 1.7;
      }

      .container {
        width: min(var(--max-width), calc(100% - 2rem));
        margin: 0 auto;
      }

      .site-header {
        position: sticky;
        top: 0;
        z-index: 10;
        backdrop-filter: blur(10px);
        background: rgba(8, 26, 58, 0.92);
        font-family: "Ubuntu Mono", monospace;
        letter-spacing: 0.1em;
        border-bottom: 1px solid var(--header-border);
        box-shadow: 0 6px 20px rgba(0, 0, 0, 0.12);
      }

      .nav {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 1rem;
        min-height: 72px;
      }

      .brand {
        display: inline-flex;
        align-items: center;
        gap: 1.2rem;
        font-weight: 800;
        font-size: 1rem;
        color: var(--header-text);
      }

      .brand-logo {
        height: 40px;
        width: auto;
        display: block;
      }

      .nav-links {
        display: flex;
        align-items: center;
        gap: 1.25rem;
      }

      .nav-links a {
        color: var(--header-muted);
        font-weight: 600;
      }

      .nav-links a:hover {
        color: var(--brand-gold);
      }

      main {
        padding: 3.5rem 0 4rem;
      }

      .section {
        margin-top: 3rem;
      }

      .lede {
        font-size: 1.1rem;
        max-width: 760px;
        color: var(--muted);
      }

      .button-link {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        padding: 0.8rem 1rem;
        border: 1px solid #cfab70;
        border-radius: 999px;
        background: var(--brand-gold);
        color: var(--brand-blue);
        font-weight: 700;
        font-family: "Inter", system-ui, sans-serif;
        transition:
          transform 0.18s ease,
          background 0.18s ease,
          border-color 0.18s ease,
          box-shadow 0.18s ease;
      }

      .button-link:hover {
        transform: translateY(-1px);
        background: #ebcca0;
        border-color: #ebcca0;
        color: var(--brand-blue);
        box-shadow: 0 8px 20px rgba(0, 45, 114, 0.14);
      }

      .grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
        gap: 1rem;
      }

      .site-footer {
        margin-top: 4rem;
        background: var(--footer-bg);
        border-top: 1px solid var(--header-border);
        box-shadow: 0 -4px 20px rgba(0, 0, 0, 0.06);
      }

      .footer-inner {
        padding: 2rem 0 3rem;
      }

      .footer-title {
        margin: 0 0 0.5rem;
        font-weight: 700;
        color: var(--header-text);
      }

      .footer-links {
        display: flex;
        flex-wrap: wrap;
        gap: 0.75rem;
        color: var(--header-muted);
      }

      .footer-links a {
        color: var(--header-muted);
      }

      .footer-links a:hover {
        color: var(--brand-gold);
      }

      .card {
        display: flex;
        flex-direction: column;
        height: 100%;
        border: 1px solid var(--border);
        background: var(--panel);
        border-radius: var(--radius);
        box-shadow: var(--shadow);
        overflow: hidden;
        text-decoration: none;
        color: inherit;
        transition:
          transform 0.18s ease,
          border-color 0.18s ease,
          background 0.18s ease,
          box-shadow 0.18s ease;
      }

      .card:hover {
        transform: translateY(-3px);
        border-color: var(--brand-blue-light);
        background: var(--panel-hover);
        box-shadow: 0 14px 34px rgba(0, 0, 0, 0.12);
      }

      .card-body {
        padding: 1.25rem;
        display: flex;
        flex-direction: column;
        flex: 1;
      }

      .card-title {
        margin: 0 0 0.75rem;
      }

      .card-text {
        margin: 0 0 1.25rem;
        color: var(--muted);
      }

      .card-link {
        display: inline-flex;
        align-items: center;
        gap: 0.4rem;
        font-weight: 600;
        margin-top: auto;
      }

      .card-media {
        width: 100%;
        aspect-ratio: 16 / 9;
        overflow: hidden;
        background: rgba(255, 255, 255, 0.03);
        border-bottom: 1px solid rgba(42, 57, 102, 0.7);
      }

      .card-media img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        display: block;
      }

      .project-hero {
        width: 100%;
        max-width: 900px;
        margin: 2rem auto 2.5rem;
        border-radius: var(--radius);
        overflow: hidden;
        border: 1px solid var(--border);
        box-shadow: var(--shadow);
      }

      .project-hero img {
        width: 100%;
        height: auto;
        display: block;
        object-fit: cover;
      }

      @media (max-width: 640px) {
        .nav {
          min-height: auto;
          padding: 1rem 0;
          flex-direction: column;
          align-items: flex-start;
        }

        main {
          padding-top: 2.5rem;
        }
      }
    </style>
  </head>
  <body>
    <header class="site-header">
      <div class="container nav">
        <a class="brand" href="/">
          <img src="/images/hgds-logo.png" alt="Hopkins Game Dev Society logo" class="brand-logo" />
          <span class="brand-text">Hopkins Game Dev Society</span>
        </a>

        <nav class="nav-links">
          <a href="/about">About</a>
          <a href="/projects">Projects</a>
        </nav>
      </div>
    </header>

    <main class="container">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="container footer-inner">
        <p class="footer-title">Hopkins Game Dev Society</p>

        <div class="footer-links">
          <a href="https://discord.com/invite/AvyRN8Y8wk" target="_blank" rel="noopener noreferrer">
            Discord
          </a>
          <span>·</span>
          <a href="mailto:hopkinsgamedevclub@gmail.com">hopkinsgamedevclub@gmail.com</a>
        </div>
      </div>
    </footer>
  </body>
</html>